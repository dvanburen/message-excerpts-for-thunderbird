{
  "manifest_version": 3,
  "name": "Message Excerpts – Two-Line Cards",
  "description": "Shows up to two lines of message text below the subject in three-row Cards View.",
  "version": "0.1.5.1",
  "author": "Michael Markl",
  "homepage_url": "https://github.com/michael-markl/message-excerpts-for-thunderbird",
  "browser_specific_settings": {
    "gecko": {
      "id": "message-excerpts-two-line-cards@local.invalid",
      "strict_min_version": "128.0"
    }
  },
  "background": {
    "scripts": [
      "background.js"
    ]
  },
  "options_ui": {
    "page": "options/options.html"
  },
  "icons": {
    "48": "icon.svg",
    "96": "icon.svg"
  },
  "permissions": [
    "messagesRead",
    "storage"
  ],
  "experiment_apis": {
    "messageExcerpts": {
      "schema": "api/messageExcerpts/schema.json",
      "parent": {
        "scopes": [
          "addon_parent"
        ],
        "paths": [
          [
            "messageExcerpts"
          ]
        ],
        "script": "api/messageExcerpts/implementation.js"
      }
    }
  }
}
